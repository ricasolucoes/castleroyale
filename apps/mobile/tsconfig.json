{
  "extends": ["expo/tsconfig.base", "@castleroyale/tooling/tsconfig-react-native"],
  "compilerOptions": {
    // No `baseUrl` — deprecated in TypeScript 6. Path mappings resolve
    // relative to this file.
    "paths": {
      "@/*": ["./src/*"],
      "@castleroyale/contracts": ["../../packages/contracts/src/index.ts"],
      "@castleroyale/tooling/design-tokens": ["../../packages/tooling/design-tokens/index.ts"]
    },
    "types": ["node", "jest"],
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", ".expo", "dist", "ios", "android"]
}
