{
  "expo": {
    "name": "Castle Royale",
    "slug": "castleroyale",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "castleroyale",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1116",
    "primaryColor": "#B4762E",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.ricasolucoes.castleroyale",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "br.com.ricasolucoes.castleroyale",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0E1116"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1116",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://castleroyale.ricasolucoes.com.br/api/v1",
      "gamesPortalUrl": "https://games.ricasolucoes.com.br/api/v1",
      "realtime": {
        "host": "castleroyale.ricasolucoes.com.br",
        "port": 443,
        "scheme": "https",
        "key": "castleroyale-key-prod"
      },
      "router": {
        "root": "app"
      }
    }
  }
}
