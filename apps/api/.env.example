###############################################################################
# Project Dominion — API environment
#
# Copy to `.env` and adjust. Never commit a populated `.env`.
# The defaults below target the Docker development stack shipped in
# `infrastructure/docker` (see `docker-compose.yml` at the repository root).
###############################################################################

# --- Application -------------------------------------------------------------
APP_NAME="Project Dominion"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

# --- Game identity -----------------------------------------------------------
# Single source of truth for the product name. See config/game.php.
GAME_NAME="Project Dominion"
GAME_CODE=dominion
GAME_SUPPORT_EMAIL=support@example.test

# --- Game data / content versioning -----------------------------------------
# Bumped whenever balancing data changes. Battles record the version they ran
# under so historical replays stay reproducible. See ADR-015.
GAME_DATA_VERSION=1
GAME_COMBAT_VERSION=1
GAME_ECONOMY_VERSION=1

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (PostgreSQL + PostGIS) ----------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dominion
DB_USERNAME=dominion
DB_PASSWORD=dominion
DB_SSLMODE=prefer

# --- Cache / Session / Queue -------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=dominion_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# --- Redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_PREFIX=dominion_

# --- Horizon -----------------------------------------------------------------
HORIZON_PREFIX=dominion_horizon:
HORIZON_DOMAIN=null
HORIZON_PATH=horizon

# --- Broadcasting / Reverb ---------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=dominion-local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

# Public values handed to the mobile client (never expose REVERB_APP_SECRET).
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8081
REVERB_PUBLIC_SCHEME=http

# --- Octane ------------------------------------------------------------------
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

# --- Filesystem / Object storage --------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=dominion
AWS_SECRET_ACCESS_KEY=dominion-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dominion-local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${GAME_NAME}"

# --- Authentication ----------------------------------------------------------
# Access tokens are short-lived; refresh tokens rotate. See docs/api/authentication.md
AUTH_ACCESS_TOKEN_TTL_MINUTES=60
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_DEVICE_SESSIONS=5
AUTH_GUEST_ACCOUNTS_ENABLED=true

APPLE_SIGN_IN_CLIENT_ID=
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=

GOOGLE_SIGN_IN_CLIENT_ID_ANDROID=
GOOGLE_SIGN_IN_CLIENT_ID_IOS=
GOOGLE_SIGN_IN_CLIENT_ID_WEB=

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_COMMAND_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20

# --- Feature flags -----------------------------------------------------------
# Runtime flags live in the database; these are bootstrap defaults only.
FEATURE_FLAGS_DRIVER=database
FEATURE_FLAGS_CACHE_TTL=30

# --- Admin panel (Filament) --------------------------------------------------
FILAMENT_PATH=admin
FILAMENT_DOMAIN=null

# --- Debug tooling -----------------------------------------------------------
# MUST be false in staging/production. Guarded additionally by APP_ENV.
DEBUG_MENU_ENABLED=true
DEBUG_TIME_SCALE=1

# --- Observability -----------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dominion-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SENTRY_LARAVEL_DSN=

# --- Back-office bootstrap ---------------------------------------------------
# Required outside local/testing; the seeder refuses to invent a password.
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=
