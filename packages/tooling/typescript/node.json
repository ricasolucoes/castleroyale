{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Castle Royale Node",
  "extends": "./base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    // These packages run under `node --experimental-strip-types`, which
    // requires explicit .ts specifiers on relative imports.
    "allowImportingTsExtensions": true
  }
}
